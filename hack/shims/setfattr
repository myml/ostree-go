#!/usr/bin/env python3
"""Minimal setfattr(1) replacement for environments without the attr package.

Implements only the options used by OSTree's shell tests:

    setfattr -n NAME -v VALUE FILE...
    setfattr -x NAME FILE...
"""
import os
import sys


def usage():
    sys.stderr.write(
        "usage: setfattr -n name [-v value] file...\n"
        "       setfattr -x name file...\n"
    )


def main(argv):
    name = None
    value = None
    remove = False
    files = []
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg in ("-n", "--name"):
            i += 1
            if i >= len(argv):
                usage()
                return 2
            name = argv[i]
        elif arg.startswith("--name="):
            name = arg.split("=", 1)[1]
        elif arg in ("-v", "--value"):
            i += 1
            if i >= len(argv):
                usage()
                return 2
            value = argv[i]
        elif arg.startswith("--value="):
            value = arg.split("=", 1)[1]
        elif arg in ("-x", "--remove"):
            remove = True
        elif arg in ("-h", "--help"):
            usage()
            return 0
        elif arg.startswith("-"):
            sys.stderr.write(f"setfattr: unrecognized option '{arg}'\n")
            return 2
        else:
            files.append(arg)
        i += 1

    if name is None or not files or (not remove and value is None) or (remove and value is not None):
        usage()
        return 2

    rc = 0
    for path in files:
        try:
            if remove:
                os.removexattr(path, name)
            else:
                data = value.encode()
                if value.startswith("0x"):
                    try:
                        data = bytes.fromhex(value[2:])
                    except ValueError:
                        pass
                os.setxattr(path, name, data)
        except OSError as exc:
            sys.stderr.write(f"setfattr: {path}: {exc.strerror}\n")
            rc = 1
    return rc


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
