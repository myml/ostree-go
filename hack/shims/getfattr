#!/usr/bin/env python3
"""Minimal getfattr(1) replacement for environments without the attr package.

Supports the subset used by OSTree's shell tests:

    getfattr [-d] [-m PATTERN] [--encoding=base64] [-n NAME]
             [--only-values] FILE...
"""
import base64
import os
import re
import sys


def usage():
    sys.stderr.write(
        "usage: getfattr [-d] [-m pattern] [--encoding=base64] [-n name] "
        "[--only-values] file...\n"
    )


def quote_value(data):
    """Render a value the way attr's default text encoding does."""
    out = []
    for byte in data:
        ch = chr(byte)
        if ch in ('"', "\\"):
            out.append("\\" + ch)
        elif 0x20 <= byte < 0x7F:
            out.append(ch)
        else:
            out.append("\\%03o" % byte)
    return "".join(out)


def main(argv):
    name = None
    match = None
    encoding = None
    only_values = False
    files = []
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg in ("-n", "--name"):
            i += 1
            if i >= len(argv):
                usage()
                return 2
            name = argv[i]
        elif arg.startswith("--name="):
            name = arg.split("=", 1)[1]
        elif arg in ("-m", "--match"):
            i += 1
            if i >= len(argv):
                usage()
                return 2
            match = argv[i]
        elif arg.startswith("--match="):
            match = arg.split("=", 1)[1]
        elif arg.startswith("--encoding="):
            encoding = arg.split("=", 1)[1]
        elif arg in ("-e", "--e"):
            i += 1
            if i >= len(argv):
                usage()
                return 2
            encoding = argv[i]
        elif arg in ("-d", "--dump"):
            # Dumping is the default; accepted for compatibility.
            pass
        elif arg == "--only-values":
            only_values = True
        elif arg in ("-h", "--help"):
            usage()
            return 0
        elif arg.startswith("-"):
            sys.stderr.write(f"getfattr: unrecognized option '{arg}'\n")
            return 2
        else:
            files.append(arg)
        i += 1

    if not files:
        usage()
        return 2
    if encoding not in (None, "text", "base64"):
        sys.stderr.write(f"getfattr: unsupported encoding '{encoding}'\n")
        return 2

    pattern = re.compile(match) if match else None
    rc = 0
    for path in files:
        try:
            names = os.listxattr(path)
        except OSError as exc:
            sys.stderr.write(f"getfattr: {path}: {exc.strerror}\n")
            rc = 1
            continue
        if name is not None:
            if name not in names:
                sys.stderr.write(f"getfattr: {path}: {name}: No such attribute\n")
                rc = 1
                continue
            names = [name]
        elif pattern is not None:
            names = [n for n in names if pattern.search(n)]
        names.sort()

        if only_values:
            for attr in names:
                try:
                    value = os.getxattr(path, attr)
                except OSError as exc:
                    sys.stderr.write(f"getfattr: {path}: {exc.strerror}\n")
                    rc = 1
                    continue
                sys.stdout.buffer.write(value)
                sys.stdout.buffer.write(b"\n")
            continue

        print(f"# file: {path}")
        for attr in names:
            try:
                value = os.getxattr(path, attr)
            except OSError as exc:
                sys.stderr.write(f"getfattr: {path}: {exc.strerror}\n")
                rc = 1
                continue
            if encoding == "base64":
                encoded = base64.b64encode(value).decode()
                print(f'{attr}="{encoded}"')
            else:
                print(f'{attr}="{quote_value(value)}"')
    return rc


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
